{
  "name": "ts-service-health-checker",
  "version": "1.0.0",
  "description": "Dockerized TypeScript microservice for HTTP service health monitoring with automated API tests.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ipaddr.js": "^2.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  }
}
